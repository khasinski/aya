{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "dist-test",
    "rootDir": "src"
  },
  "include": [
    "src/agentPreset.ts",
    "src/bell.ts",
    "src/colors.ts",
    "src/control-status-target.ts",
    "src/diff-navigation.ts",
    "src/double-shift.ts",
    "src/focus-reporting.ts",
    "src/hooks/usePersistentPreference.ts",
    "src/project-reload.ts",
    "src/preset-ids.ts",
    "src/ptyEventBus.ts",
    "src/pty-event-reducer.ts",
    "src/terminal-option-key.ts",
    "src/terminal-keys.ts",
    "src/terminal-rendering.ts",
    "src/snippet-payload.ts",
    "src/spawnSession.ts",
    "src/types.ts",
    "src/worktree.ts"
  ]
}
