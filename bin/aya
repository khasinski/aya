#!/bin/sh
# aya — open projects and control the running Aya.app

set -e

INSTALLED_APP_SOCKET="$HOME/.aya/aya.sock"
OPEN_SOCKET_WAIT_SECONDS="${AYA_OPEN_WAIT_SECONDS:-15}"
# Keeps the wait's integer compare far from overflow (under ~3 hours).
OPEN_SOCKET_WAIT_MAX_DIGITS=4

usage() {
  cat >&2 <<'EOF'
Usage:
  aya [path]                         Open a project directory
  aya open [path]                    Open a project directory
  aya project open [path]            Open a project directory (alias)
  aya focus                          Focus the Aya window
  aya notify [--title title] body    Show an Aya notification
  aya remote --stdio                 Bridge remote Aya over stdio
  aya status set text                Show agent status for this terminal
  aya status waiting text            Mark this terminal as waiting
  aya status done text               Mark this terminal as done
  aya status error text              Mark this terminal as errored
  aya status clear                   Clear agent status
  aya pane list                      List the panes/agents in this project
  aya pane read name                 Print another pane's recent output
  aya pane send name [--no-submit] text
                                     Type text into another pane and press
                                     Enter (--no-submit: type only)
  aya team whoami                    Print this pane's team role and protocol
  aya team send role text            Send a message to the pane playing role
  aya team inbox                     Print messages that could not be typed in
  aya team new [description]         Print a guide for writing a team file
  aya team save [--replace] file|-   Check a team file and save it in Aya
  aya team open [--replace] team role=target...
                                     Give roles a pane: target is a preset
                                     (new session), this, or a pane name/id
  aya presets [--json]               List presets and whether each is installed
  aya capabilities                   Print these commands as JSON, for agents
EOF
}

# Expands a leading ~/ (a quoted env value keeps it) and collapses repeated slashes.
normalize_path() {
  case "$1" in
    "~/"*) set -- "$HOME/${1#"~/"}" ;;
  esac
  printf '%s\n' "$1" | sed 's#//*#/#g'
}

socket_path() {
  if [ -n "${AYA_SOCKET:-}" ]; then
    normalize_path "$AYA_SOCKET"
  elif [ -n "${AYA_HOME:-}" ]; then
    normalize_path "$AYA_HOME/aya.sock"
  else
    normalize_path "$INSTALLED_APP_SOCKET"
  fi
}

remote_socket_path() {
  if [ -n "${AYA_REMOTE_SOCKET:-}" ]; then
    printf '%s\n' "$AYA_REMOTE_SOCKET"
  elif [ -n "${AYA_HOME:-}" ]; then
    printf '%s\n' "$AYA_HOME/aya-remote.sock"
  else
    printf '%s\n' "$HOME/.aya/aya-remote.sock"
  fi
}

send_control() {
  socket=$(socket_path)
  if [ ! -S "$socket" ]; then
    printf "aya: control socket not found at %s\n" "$socket" >&2
    printf "aya: start Aya first, or use 'aya open <path>' to launch it.\n" >&2
    exit 1
  fi

  node - "$socket" "$@" <<'NODE'
const net = require("node:net");
const socketPath = process.argv[2];
const kind = process.argv[3];

function optionalEnv(name) {
  const value = process.env[name];
  return value && value.trim() ? value : undefined;
}

function requestFromArgs() {
  if (kind === "focus") return { type: "focus" };
  if (kind === "capabilities") return { type: "capabilities" };
  if (kind === "open") return { type: "open", path: process.argv[4] };
  if (kind === "notify") {
    return {
      type: "notify",
      title: process.argv[4] || undefined,
      body: process.argv[5],
      terminalId: optionalEnv("AYA_TERMINAL_ID"),
      projectSlug: optionalEnv("AYA_PROJECT_SLUG"),
    };
  }
  if (kind === "status") {
    return {
      type: "status",
      level: process.argv[4],
      text: process.argv[5] || undefined,
      terminalId: optionalEnv("AYA_TERMINAL_ID"),
      projectSlug: optionalEnv("AYA_PROJECT_SLUG"),
      cwd: optionalEnv("AYA_PROJECT_DIR") || process.cwd(),
    };
  }
  if (kind === "pane-list") {
    return {
      type: "pane-list",
      projectSlug: optionalEnv("AYA_PROJECT_SLUG"),
      selfTerminalId: optionalEnv("AYA_TERMINAL_ID"),
    };
  }
  // pane read/send target ANOTHER terminal, so the caller's own project scopes
  // the name lookup — "reviewer" means the one in this project.
  if (kind === "pane-read") {
    return {
      type: "pane-read",
      target: process.argv[4],
      projectSlug: optionalEnv("AYA_PROJECT_SLUG"),
    };
  }
  if (kind === "pane-send") {
    return {
      type: "pane-send",
      target: process.argv[4],
      text: process.argv[5],
      submit: process.argv[6] === "submit",
      projectSlug: optionalEnv("AYA_PROJECT_SLUG"),
    };
  }
  if (kind === "team-whoami" || kind === "team-inbox") return { type: kind };
  if (kind === "team-send") {
    return { type: "team-send", role: process.argv[4], text: process.argv[5] };
  }
  if (kind === "presets") return { type: kind, json: process.argv[4] === "json" };
  // Unlike whoami/send, these work outside a pane too: the slug or cwd names the project.
  if (kind === "team-guide" || kind === "team-save" || kind === "team-open") {
    const scope = { projectSlug: optionalEnv("AYA_PROJECT_SLUG"), cwd: process.cwd() };
    if (kind === "team-guide") return { type: kind, description: process.argv[4] || undefined, ...scope };
    const replace = process.argv[5] === "replace";
    if (kind === "team-save") return { type: kind, text: process.argv[4], replace, ...scope };
    const panes = process.argv.slice(6).map((pair) => {
      const at = pair.indexOf("=");
      return { role: pair.slice(0, at), target: pair.slice(at + 1) };
    });
    return { type: kind, team: process.argv[4], panes, replace, ...scope };
  }
  throw new Error(`unknown command: ${kind}`);
}

// Which pane is calling, on every request: Aya counts per harness how many
// panes ever use this CLI (#117). Absent outside Aya.
const request = {
  ...requestFromArgs(),
  caller: {
    terminalId: optionalEnv("AYA_TERMINAL_ID"),
    presetId: optionalEnv("AYA_PRESET_ID"),
    // Set by Aya's own automatic-status hooks, so their calls don't read as
    // the agent adopting the CLI.
    via: optionalEnv("AYA_VIA"),
  },
};
const client = net.createConnection(socketPath);
let response = "";

client.setEncoding("utf8");
client.on("connect", () => {
  client.write(`${JSON.stringify(request)}\n`);
});
client.on("data", (chunk) => {
  response += chunk;
});
client.on("error", (err) => {
  console.error(`aya: ${err.message}`);
  process.exitCode = 1;
});
client.on("end", () => {
  if (!response.trim()) return;
  const parsed = JSON.parse(response);
  if (!parsed.ok) {
    console.error(`aya: ${parsed.error || "command failed"}`);
    process.exitCode = 1;
    return;
  }
  // pane read / pane list / capabilities: the payload IS the answer.
  if (typeof parsed.output === "string") process.stdout.write(parsed.output);
});
NODE
}

remote_stdio() {
  socket=$(remote_socket_path)
  node - "$socket" <<'NODE'
const net = require("node:net");
const socketPath = process.argv[2];

function write(message) {
  process.stdout.write(`${JSON.stringify(message)}\n`);
}

function fail(code, message, extra = {}) {
  write({ type: "error", code, message, ...extra });
  process.exitCode = 1;
}

const client = net.createConnection(socketPath);
let settled = false;

const timeout = setTimeout(() => {
  if (settled) return;
  settled = true;
  client.destroy();
  fail("app_unavailable", `Aya is not accepting connections at ${socketPath}`);
}, 1500);

client.on("connect", () => {
  if (settled) return;
  settled = true;
  clearTimeout(timeout);
  process.stdin.pipe(client);
  client.pipe(process.stdout);
});

process.stdin.on("end", () => {
  client.end();
});

client.on("close", () => {
  process.exit(process.exitCode || 0);
});

client.on("error", (err) => {
  if (settled) return;
  settled = true;
  clearTimeout(timeout);
  fail("app_unavailable", `Aya is not accepting connections at ${socketPath}`, {
    detail: err.code || err.message,
  });
});
NODE
}

# A named instance (AYA_SOCKET / AYA_HOME) may still be starting; launching the
# installed app instead would open the project in the wrong Aya.
wait_for_named_socket() {
  if case "$OPEN_SOCKET_WAIT_SECONDS" in
    *[!0-9]*) true ;;
    *) [ "${#OPEN_SOCKET_WAIT_SECONDS}" -gt "$OPEN_SOCKET_WAIT_MAX_DIGITS" ] ;;
  esac; then
    printf "aya: AYA_OPEN_WAIT_SECONDS must be whole seconds, at most %s digits, got '%s'\n" \
      "$OPEN_SOCKET_WAIT_MAX_DIGITS" "$OPEN_SOCKET_WAIT_SECONDS" >&2
    exit 1
  fi
  waited=0
  while [ ! -S "$1" ]; do
    if [ "$waited" -ge "$OPEN_SOCKET_WAIT_SECONDS" ]; then
      printf "aya: no Aya is listening at %s (waited %ss)\n" "$1" "$OPEN_SOCKET_WAIT_SECONDS" >&2
      printf "aya: start that instance, or unset AYA_SOCKET and AYA_HOME to use the installed Aya.\n" >&2
      exit 1
    fi
    sleep 1
    waited=$((waited + 1))
  done
}

open_project() {
  target="${1:-.}"
  if [ -d "$target" ]; then
    abs=$(cd "$target" && pwd -P)
  else
    printf "aya: '%s' is not a directory\n" "$target" >&2
    exit 1
  fi

  socket=$(socket_path)
  if [ "$socket" != "$(normalize_path "$INSTALLED_APP_SOCKET")" ]; then
    wait_for_named_socket "$socket"
  fi
  if [ -S "$socket" ]; then
    send_control open "$abs"
    return
  fi

  case "$(uname -s)" in
    Darwin)
      if [ -d "/Applications/Aya.app" ]; then
        open -n -a "Aya" --args "$abs"
      else
        printf "aya: /Applications/Aya.app not found — run 'npm run package' and install the DMG\n" >&2
        exit 1
      fi
      ;;
    Linux)
      if command -v aya-app >/dev/null 2>&1; then
        aya-app "$abs" >/dev/null 2>&1 &
      else
        printf "aya: install the Aya AppImage / linux binary as 'aya-app' on PATH\n" >&2
        exit 1
      fi
      ;;
    *)
      printf "aya: unsupported platform '%s'\n" "$(uname -s)" >&2
      exit 1
      ;;
  esac
}

command="${1:-open}"
case "$command" in
  -h|--help|help)
    usage
    ;;
  open)
    [ "$#" -eq 0 ] || shift
    open_project "${1:-.}"
    ;;
  project)
    [ "$#" -eq 0 ] || shift
    if [ "${1:-}" != "open" ]; then
      usage
      exit 1
    fi
    [ "$#" -eq 0 ] || shift
    open_project "${1:-.}"
    ;;
  focus)
    send_control focus
    ;;
  capabilities)
    send_control capabilities
    ;;
  presets)
    [ "$#" -eq 0 ] || shift
    case "${1:-}" in
      "") send_control presets "" ;;
      --json) [ "$#" -eq 1 ] || { usage; exit 1; }; send_control presets json ;;
      *) usage; exit 1 ;;
    esac
    ;;
  notify)
    [ "$#" -eq 0 ] || shift
    title=""
    if [ "${1:-}" = "--title" ]; then
      [ "$#" -eq 0 ] || shift
      title="${1:-}"
      [ "$#" -eq 0 ] || shift
    fi
    body="$*"
    if [ -z "$body" ]; then
      usage
      exit 1
    fi
    send_control notify "$title" "$body"
    ;;
  remote)
    [ "$#" -eq 0 ] || shift
    if [ "${1:-}" != "--stdio" ]; then
      usage
      exit 1
    fi
    remote_stdio
    ;;
  pane)
    [ "$#" -eq 0 ] || shift
    action="${1:-}"
    [ "$#" -eq 0 ] || shift
    case "$action" in
      list|ls)
        send_control pane-list
        ;;
      read)
        target="${1:-}"
        if [ -z "$target" ]; then
          usage
          exit 1
        fi
        send_control pane-read "$target"
        ;;
      send)
        target="${1:-}"
        [ "$#" -eq 0 ] || shift
        # Submit by default: an unsent handoff gets glued onto the next input (#116).
        # Flags count in any position; `--` ends flag parsing.
        submit="submit"
        text=""
        literal=""
        for arg do
          if [ -z "$literal" ]; then
            case "$arg" in
              --submit) continue ;;
              --no-submit) submit=""; continue ;;
              --) literal=1; continue ;;
            esac
          fi
          text="${text:+$text }$arg"
        done
        if [ -z "$target" ] || [ -z "$text" ]; then
          usage
          exit 1
        fi
        send_control pane-send "$target" "$text" "$submit"
        ;;
      *)
        usage
        exit 1
        ;;
    esac
    ;;
  team)
    [ "$#" -eq 0 ] || shift
    action="${1:-}"
    [ "$#" -eq 0 ] || shift
    case "$action" in
      whoami) send_control team-whoami ;;
      inbox) send_control team-inbox ;;
      new) send_control team-guide "$*" ;;
      save)
        replace=""
        file=""
        for arg do
          case "$arg" in
            --replace) replace="replace" ;;
            *)
              if [ -n "$file" ]; then
                usage
                exit 1
              fi
              file="$arg"
              ;;
          esac
        done
        if [ -z "$file" ]; then
          usage
          exit 1
        fi
        if [ "$file" = "-" ]; then
          text=$(cat)
        elif [ -f "$file" ]; then
          text=$(cat -- "$file")
        else
          printf "aya: no such file: %s\n" "$file" >&2
          exit 1
        fi
        if [ -z "$(printf '%s' "$text" | tr -d '[:space:]')" ]; then
          printf "aya: %s is empty; nothing was saved\n" "$file" >&2
          exit 1
        fi
        send_control team-save "$text" "$replace"
        ;;
      open)
        replace=""
        team=""
        # Rebuilds "$@" as the role=target pairs alone, checked before the app sees them.
        for arg do
          shift
          case "$arg" in
            --replace) replace="replace" ;;
            *)
              if [ -z "$team" ]; then
                team="$arg"
                continue
              fi
              role="${arg%%=*}"
              if [ "$role" = "$arg" ] || [ -z "$role" ] || [ -z "${arg#*=}" ]; then
                printf "aya: expected role=target, got '%s'; nothing was opened\n" "$arg" >&2
                exit 1
              fi
              set -- "$@" "$arg"
              ;;
          esac
        done
        if [ -z "$team" ] || [ "$#" -eq 0 ]; then
          usage
          exit 1
        fi
        send_control team-open "$team" "$replace" "$@"
        ;;
      send)
        role="${1:-}"
        [ "$#" -eq 0 ] || shift
        text="$*"
        if [ -z "$role" ] || [ -z "$text" ]; then
          usage
          exit 1
        fi
        send_control team-send "$role" "$text"
        ;;
      *)
        usage
        exit 1
        ;;
    esac
    ;;
  status)
    [ "$#" -eq 0 ] || shift
    level="${1:-}"
    [ "$#" -eq 0 ] || shift
    case "$level" in
      set|active) level="active" ;;
      waiting|done|error|clear) ;;
      *)
        usage
        exit 1
        ;;
    esac
    text="$*"
    if [ "$level" != "clear" ] && [ -z "$text" ]; then
      usage
      exit 1
    fi
    send_control status "$level" "$text"
    ;;
  *)
    open_project "$command"
    ;;
esac
