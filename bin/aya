#!/bin/sh
# aya - open projects and control the running Aya.app

set -e

INSTALLED_APP_SOCKET="$HOME/.aya/aya.sock"
OPEN_SOCKET_WAIT_SECONDS="${AYA_OPEN_WAIT_SECONDS:-15}"
# Keeps the wait's integer compare far from overflow (under ~3 hours).
OPEN_SOCKET_WAIT_MAX_DIGITS=4
# send_control's exit status for a socket file nothing listens on.
NOT_LISTENING_EXIT=75
# Longest socket path that binds (measured), as electron/socket-path.ts has it.
DARWIN_SOCKET_PATH_MAX_BYTES=104
LINUX_SOCKET_PATH_MAX_BYTES=107
# "debug on": the switch in the config home and each team's log, as electron/team-debug.ts names them.
DEBUG_SWITCH_FILE=debug.json
DEBUG_LOG_FILE=debug.jsonl
# Every saved team has it (electron/team-records.ts TEAM_FILES.saved): how team stats finds the team's project.
TEAM_SAVED_FILE=saved.md

usage() {
  cat >&2 <<'EOF'
Usage:
  aya [path]                         Open a project directory
  aya open [path]                    Open a project directory
  aya project open [path]            Open a project directory (alias)
  aya focus                          Focus the Aya window
  aya notify [--title title] body    Show an Aya notification
  aya remote --stdio                 Bridge remote Aya over stdio
  aya status set text                Show agent status for this terminal
  aya status waiting text            Mark this terminal as waiting
  aya status done text               Mark this terminal as done
  aya status error text              Mark this terminal as errored
  aya status clear                   Clear agent status
  aya pane list [--project slug]     List the panes/agents in this project
  aya pane read target [--project slug]
                                     Print another pane's recent output;
                                     target is a pane name or an id from
                                     aya pane list
  aya pane send target [--no-submit] [--project slug] text
                                     Type text into another pane and press
                                     Enter (--no-submit: type only)
  aya team whoami                    Print this pane's team role and protocol
  aya team send role text            Send a message to the pane playing role
  aya team inbox                     Print messages that could not be typed in
  aya team pause ["why"]             The lead ends the team's work: pauses it, as the Pause button does
  aya team new [description]         Print a guide for writing a team file
  aya team save [--replace] file|-   Check a team file and save it in Aya
  aya team open [--replace] team role=target...
                                     Give roles a pane: target is a preset
                                     (new session), this, or a pane name/id;
                                     new:preset / pane:name when both match
  aya team start team ["task"] [--to role]
                                     Start a team as the Teams window's Start;
                                     a task goes to --to, else the
                                     lead (the role with the
                                     cadence is the lead), else
                                     the first role
  aya team debug team [-f]          Print the team's last debug entries
                                     (-f: and follow them)
  aya team stats team [--json|--now]
                                     Print what Aya did for the team: messages
                                     per sender and receiver, rounds, holds,
                                     inboxes, read marks, commits (--now: the
                                     lead's round digest instead)
  aya debug on|off|status            Turn on/off writing every team decision
                                     to the team's debug log
  aya presets [--json]               List presets, whether each is installed and
                                     whether a role's pane of it reaches Aya
  aya machines [--json]              Show every registered machine: reachability,
                                     GPU, CPU, memory, Ollama and hot models
  aya machines hosts [--json]        List known ssh hosts: ~/.ssh/config aliases, remote
                                     projects and added machines, with their sources
  aya machines add "sentence"        Draft machines from a sentence; the user adds them in Aya
  aya machines remove id             Remove a machine (asks in Aya)
  aya machines occupy id "purpose"   Say you are using a machine (advisory, not enforced)
  aya machines free id               Clear a machine's occupancy
  aya capabilities                   Print these commands as JSON, for agents
EOF
}

usage_fail() {
  usage
  exit 1
}

# Expands a leading ~/ (a quoted env value keeps it) and collapses repeated slashes.
normalize_path() {
  case "$1" in
    "~/"*) set -- "$HOME/${1#"~/"}" ;;
  esac
  printf '%s\n' "$1" | sed 's#//*#/#g'
}

# True when AYA_HOME names a home; the app ignores a blank or whitespace-only one.
aya_home_set() {
  case "${AYA_HOME:-}" in
    *[![:space:]]*) return 0 ;;
    *) return 1 ;;
  esac
}

socket_path() {
  if [ -n "${AYA_SOCKET:-}" ]; then
    normalize_path "$AYA_SOCKET"
  elif aya_home_set; then
    normalize_path "$AYA_HOME/aya.sock"
  else
    normalize_path "$INSTALLED_APP_SOCKET"
  fi
}

remote_socket_path() {
  if [ -n "${AYA_REMOTE_SOCKET:-}" ]; then
    printf '%s\n' "$AYA_REMOTE_SOCKET"
  elif aya_home_set; then
    printf '%s\n' "$AYA_HOME/aya-remote.sock"
  else
    printf '%s\n' "$HOME/.aya/aya-remote.sock"
  fi
}

socket_path_limit() {
  case "$(uname -s)" in
    Darwin) echo "$DARWIN_SOCKET_PATH_MAX_BYTES" ;;
    *) echo "$LINUX_SOCKET_PATH_MAX_BYTES" ;;
  esac
}

# Sets path_length and path_limit; succeeds when the path is over the limit.
socket_path_too_long() {
  path_length=$(printf '%s' "$1" | wc -c | tr -d ' ')
  path_limit=$(socket_path_limit)
  [ "$path_length" -gt "$path_limit" ]
}

fail_if_socket_path_too_long() {
  if socket_path_too_long "$1"; then
    printf "aya: control socket path is too long (%s bytes, the limit is %s): %s\n" "$path_length" "$path_limit" "$1" >&2
    if [ -n "${AYA_SOCKET:-}" ]; then
      printf "aya: set AYA_SOCKET to a shorter path.\n" >&2
    else
      printf "aya: set AYA_HOME to a shorter directory.\n" >&2
    fi
    exit 1
  fi
}

# With connect_wait set (whole seconds), a socket that is missing or refuses
# (a stale file from a crashed Aya) is retried until then instead of failing.
send_control() {
  socket=$(socket_path)
  fail_if_socket_path_too_long "$socket"
  if [ -z "${connect_wait:-}" ] && [ ! -S "$socket" ]; then
    printf "aya: control socket not found at %s\n" "$socket" >&2
    printf "aya: start Aya first, or use 'aya open <path>' to launch it.\n" >&2
    exit 1
  fi

  AYA_CONNECT_WAIT_SECONDS="${connect_wait:-}" AYA_NOT_LISTENING_EXIT="${exit_if_not_listening:+$NOT_LISTENING_EXIT}" node - "$socket" "$@" <<'NODE'
const net = require("node:net");
const socketPath = process.argv[2];
const kind = process.argv[3];
const connectWait = process.env.AYA_CONNECT_WAIT_SECONDS || "";
const CONNECT_RETRY_MS = 200;

function optionalEnv(name) {
  const value = process.env[name];
  return value && value.trim() ? value : undefined;
}

function requestFromArgs() {
  if (kind === "focus") return { type: "focus" };
  if (kind === "capabilities") return { type: "capabilities" };
  if (kind === "open") return { type: "open", path: process.argv[4] };
  if (kind === "notify") {
    return {
      type: "notify",
      title: process.argv[4] || undefined,
      body: process.argv[5],
      terminalId: optionalEnv("AYA_TERMINAL_ID"),
      projectSlug: optionalEnv("AYA_PROJECT_SLUG"),
    };
  }
  if (kind === "status") {
    return {
      type: "status",
      level: process.argv[4],
      text: process.argv[5] || undefined,
      terminalId: optionalEnv("AYA_TERMINAL_ID"),
      projectSlug: optionalEnv("AYA_PROJECT_SLUG"),
      cwd: optionalEnv("AYA_PROJECT_DIR") || process.cwd(),
    };
  }
  // --project beats the pane's own project, which otherwise scopes every lookup.
  if (kind === "pane-list") {
    return {
      type: "pane-list",
      projectSlug: process.argv[4] || optionalEnv("AYA_PROJECT_SLUG"),
      selfTerminalId: optionalEnv("AYA_TERMINAL_ID"),
    };
  }
  // pane read/send target ANOTHER terminal, so the caller's own project scopes
  // the name lookup - "reviewer" means the one in this project.
  if (kind === "pane-read") {
    return {
      type: "pane-read",
      target: process.argv[4],
      projectSlug: process.argv[5] || optionalEnv("AYA_PROJECT_SLUG"),
    };
  }
  if (kind === "pane-send") {
    return {
      type: "pane-send",
      target: process.argv[4],
      text: process.argv[5],
      submit: process.argv[6] === "submit",
      projectSlug: process.argv[7] || optionalEnv("AYA_PROJECT_SLUG"),
    };
  }
  if (kind === "team-whoami" || kind === "team-inbox") return { type: kind };
  if (kind === "team-send") {
    return { type: "team-send", role: process.argv[4], text: process.argv[5] };
  }
  if (kind === "team-pause") return { type: kind, text: process.argv[4] || undefined };
  if (kind === "presets") return { type: kind, json: process.argv[4] === "json" };
  if (kind === "machines") {
    return { type: kind, argv: process.argv.slice(4), user: optionalEnv("USER") };
  }
  // Unlike whoami/send, these work outside a pane too: the slug or cwd names the project.
  if (kind === "team-guide" || kind === "team-save" || kind === "team-open" || kind === "team-start") {
    const scope = { projectSlug: optionalEnv("AYA_PROJECT_SLUG"), cwd: process.cwd() };
    if (kind === "team-guide") return { type: kind, description: process.argv[4] || undefined, ...scope };
    if (kind === "team-start") {
      return { type: kind, team: process.argv[4], task: process.argv[5] || undefined, to: process.argv[6] || undefined, ...scope };
    }
    const replace = process.argv[5] === "replace";
    if (kind === "team-save") return { type: kind, text: process.argv[4], replace, ...scope };
    const panes = process.argv.slice(6).map((pair) => {
      const at = pair.indexOf("=");
      return { role: pair.slice(0, at), target: pair.slice(at + 1) };
    });
    return { type: kind, team: process.argv[4], panes, replace, ...scope };
  }
  throw new Error(`unknown command: ${kind}`);
}

// Which pane is calling, on every request: Aya counts per harness how many
// panes ever use this CLI (#117). Absent outside Aya.
const request = {
  ...requestFromArgs(),
  caller: {
    terminalId: optionalEnv("AYA_TERMINAL_ID"),
    presetId: optionalEnv("AYA_PRESET_ID"),
    // Set by Aya's own automatic-status hooks, so their calls don't read as
    // the agent adopting the CLI.
    via: optionalEnv("AYA_VIA"),
    // Aya checks this process runs under the pane it names: a borrowed id does not.
    pid: process.pid,
  },
};
const connectDeadline = Date.now() + Number(connectWait || 0) * 1000;
// Aya answers a send once its text, gap and Enter went in, so a pane that never frees up must not hold the caller
// (an agent's tool call) forever.
const REPLY_TIMEOUT_MS = Number(process.env.AYA_REPLY_TIMEOUT_MS) || 120_000;
let response = "";

function connect() {
  const client = net.createConnection(socketPath);
  let connected = false;
  client.setEncoding("utf8");
  client.on("connect", () => {
    connected = true;
    client.write(`${JSON.stringify(request)}\n`);
    const deadline = setTimeout(() => {
      // Aya stops waiting on its Add dialog once this connection closes, so a late click adds nothing.
      const addingMachine = request.type === "machines" && request.argv[0] === "add";
      console.error(
        addingMachine
          ? `aya: no answer from Aya after ${REPLY_TIMEOUT_MS / 1000} s; nothing was added, Aya closed its dialog. Run the add again when you can answer it.`
          : `aya: no answer from Aya after ${REPLY_TIMEOUT_MS / 1000} s; the command may still be in progress (a team message shows in aya team inbox once typed).`,
      );
      process.exitCode = 1;
      client.destroy();
    }, REPLY_TIMEOUT_MS);
    client.on("close", () => clearTimeout(deadline));
  });
  client.on("data", (chunk) => {
    response += chunk;
  });
  client.on("error", (err) => {
    const notListening = err.code === "ENOENT" || err.code === "ECONNREFUSED";
    // The caller launches the app instead.
    if (process.env.AYA_NOT_LISTENING_EXIT && !connected && notListening) {
      process.exitCode = Number(process.env.AYA_NOT_LISTENING_EXIT);
      return;
    }
    if (connectWait && !connected && notListening) {
      if (Date.now() < connectDeadline) {
        setTimeout(connect, CONNECT_RETRY_MS);
        return;
      }
      console.error(`aya: no Aya is listening at ${socketPath} (waited ${connectWait}s)`);
      console.error("aya: start that instance, or unset AYA_SOCKET and AYA_HOME to use the installed Aya.");
      process.exitCode = 1;
      return;
    }
    console.error(`aya: ${err.message}`);
    process.exitCode = 1;
  });
  client.on("end", onEnd);
}

function onEnd() {
  if (!response.trim()) {
    console.error("aya: Aya closed the connection before answering; the message may or may not have been typed.");
    process.exitCode = 1;
    return;
  }
  let parsed;
  try {
    parsed = JSON.parse(response);
  } catch {
    console.error(`aya: Aya answered with something other than its reply: ${response.trim().slice(0, 200)}`);
    process.exitCode = 1;
    return;
  }
  // Refused before anything happened (Aya is still starting): from a pane, ask again.
  if (!parsed.ok && parsed.retry && connectWait && Date.now() < connectDeadline) {
    response = "";
    setTimeout(connect, CONNECT_RETRY_MS);
    return;
  }
  if (!parsed.ok) {
    console.error(`aya: ${parsed.error || "command failed"}`);
    process.exitCode = 1;
    return;
  }
  // pane read / pane list / capabilities: the payload IS the answer.
  if (typeof parsed.output === "string") process.stdout.write(parsed.output);
}

connect();
NODE
}

aya_home() {
  if aya_home_set; then
    normalize_path "$AYA_HOME"
  else
    normalize_path "$HOME/.aya"
  fi
}

# Written whole, then renamed: a running Aya reads it on its change and never sees half a file.
debug_switch() {
  home=$(aya_home)
  case "$1" in
    on|off)
      mkdir -p "$home"
      [ "$1" = on ] && value=true || value=false
      printf '{"on":%s}\n' "$value" > "$home/$DEBUG_SWITCH_FILE.tmp"
      mv -f "$home/$DEBUG_SWITCH_FILE.tmp" "$home/$DEBUG_SWITCH_FILE"
      ;;
    status) ;;
    *) usage_fail ;;
  esac
  if grep -q '"on":true' "$home/$DEBUG_SWITCH_FILE" 2>/dev/null; then
    printf "debug is on: every team decision goes to the team's %s; read it with aya team debug <team>\n" "$DEBUG_LOG_FILE"
  else
    printf "debug is off\n"
  fi
}

# The team's directory: in AYA_PROJECT_SLUG's project, else the one project whose team has `need` (a file name).
team_dir() {
  team="$1"
  need="$2"
  teams="$(aya_home)/teams"
  if [ -n "${AYA_PROJECT_SLUG:-}" ]; then
    # A slug names one directory under teams/, as a team names one under it.
    case "$AYA_PROJECT_SLUG" in
      .*|*/*) printf "aya: AYA_PROJECT_SLUG=%s does not name a project\n" "$AYA_PROJECT_SLUG" >&2; return 1 ;;
    esac
    printf '%s\n' "$teams/$AYA_PROJECT_SLUG/$team"
    return
  fi
  dir=""
  found=""
  for candidate in "$teams"/*/"$team"; do
    [ -e "$candidate/$need" ] || continue
    found="${found:+$found, }$(basename "$(dirname "$candidate")")"
    dir="$candidate"
  done
  case "$found" in
    *,*)
      printf "aya: team %s is in more than one project (%s); set AYA_PROJECT_SLUG to one of them\n" "$team" "$found" >&2
      return 1
      ;;
  esac
  printf '%s\n' "$dir"
}

# The team's debug log, in the team's directory (team_dir).
team_debug() {
  team="${1:-}"
  case "$team" in
    ""|.*|*/*) usage_fail ;;
  esac
  dir=$(team_dir "$team" "$DEBUG_LOG_FILE") || exit 1
  file="${dir:+$dir/$DEBUG_LOG_FILE}"
  if [ -z "$file" ] || { [ ! -f "$file" ] && [ "${2:-}" != follow ]; }; then
    printf "aya: no debug log for team %s yet; turn it on with aya debug on, and it fills as the team runs\n" "$team" >&2
    exit 1
  fi
  # exec: a stopped -f stops the reader too.
  exec node - "$file" "${2:-}" <<'NODE'
const fs = require("node:fs");
const [file, mode] = process.argv.slice(2);
const LAST = 50;
const POLL_MS = 300;
// The longest event name the runner logs, "round-check": the fields line up after it.
const EVENT_WIDTH = 11;

function show(line) {
  let e;
  try {
    e = JSON.parse(line);
  } catch {
    return;
  }
  const { time, event, ...fields } = e;
  const at = new Date(time);
  const clock = Number.isNaN(at.getTime()) ? "--:--:--" : at.toTimeString().slice(0, 8);
  const shown = Object.entries(fields).map(([k, v]) => `${k}=${typeof v === "string" && !/[\s"=]/.test(v) && v ? v : JSON.stringify(v)}`);
  process.stdout.write(`${clock} ${String(event).padEnd(EVENT_WIDTH)} ${shown.join(" ")}`.trimEnd() + "\n");
}

// From `from` to the end, or from the start when the file is shorter now (rotated).
function read(from) {
  try {
    const fd = fs.openSync(file, "r");
    try {
      const size = fs.fstatSync(fd).size;
      const start = size < from ? 0 : from;
      const buffer = Buffer.alloc(size - start);
      fs.readSync(fd, buffer, 0, buffer.length, start);
      const text = buffer.toString("utf8");
      const complete = text.slice(0, text.lastIndexOf("\n") + 1);
      return { lines: complete.split("\n").filter(Boolean), next: start + Buffer.byteLength(complete) };
    } finally {
      fs.closeSync(fd);
    }
  } catch {
    return { lines: [], next: from };
  }
}

let { lines, next } = read(0);
lines.slice(-LAST).forEach(show);
if (mode === "follow") {
  setInterval(() => {
    ({ lines, next } = read(next));
    lines.forEach(show);
  }, POLL_MS);
}
NODE
}

# Aya's compiled modules beside this script: the repo's or the app's (app.asar.unpacked) dist-electron.
aya_modules_dir() {
  self="$0"
  while [ -L "$self" ]; do
    link=$(readlink "$self")
    case "$link" in
      /*) self="$link" ;;
      *) self="$(dirname "$self")/$link" ;;
    esac
  done
  printf '%s/dist-electron\n' "$(cd "$(dirname "$self")/.." && pwd -P)"
}

# Read-only: counts what Aya did for the team from its files (electron/team-stats.ts), with Aya open or closed.
team_stats() {
  team="${1:-}"
  case "$team" in
    ""|.*|*/*) usage_fail ;;
  esac
  dir=$(team_dir "$team" "$TEAM_SAVED_FILE") || exit 1
  if [ -z "$dir" ] || [ ! -d "$dir" ]; then
    printf "aya: no team %s in %s; it is made when the team is saved in Aya\n" "$team" "$(aya_home)/teams" >&2
    exit 1
  fi
  stats="$(aya_modules_dir)/team-stats.js"
  if [ ! -f "$stats" ]; then
    printf "aya: team stats needs Aya's built files, not found at %s (npm run build:electron)\n" "$stats" >&2
    exit 1
  fi
  exec node "$stats" "$dir" "$team" ${2:+"$2"}
}

remote_stdio() {
  socket=$(remote_socket_path)
  if socket_path_too_long "$socket"; then
    printf '{"type":"error","code":"app_unavailable","message":"the remote socket path is too long (%s bytes, the limit is %s); set %s to a shorter path"}\n' \
      "$path_length" "$path_limit" "$([ -n "${AYA_REMOTE_SOCKET:-}" ] && echo AYA_REMOTE_SOCKET || echo AYA_HOME)"
    exit 1
  fi
  node - "$socket" <<'NODE'
const net = require("node:net");
const socketPath = process.argv[2];

function write(message) {
  process.stdout.write(`${JSON.stringify(message)}\n`);
}

function fail(code, message, extra = {}) {
  write({ type: "error", code, message, ...extra });
  process.exitCode = 1;
}

const client = net.createConnection(socketPath);
let settled = false;

const timeout = setTimeout(() => {
  if (settled) return;
  settled = true;
  client.destroy();
  fail("app_unavailable", `Aya is not accepting connections at ${socketPath}`);
}, 1500);

client.on("connect", () => {
  if (settled) return;
  settled = true;
  clearTimeout(timeout);
  process.stdin.pipe(client);
  client.pipe(process.stdout);
});

process.stdin.on("end", () => {
  client.end();
});

client.on("close", () => {
  process.exit(process.exitCode || 0);
});

client.on("error", (err) => {
  if (settled) return;
  settled = true;
  clearTimeout(timeout);
  fail("app_unavailable", `Aya is not accepting connections at ${socketPath}`, {
    detail: err.code || err.message,
  });
});
NODE
}

check_open_wait_seconds() {
  if case "$OPEN_SOCKET_WAIT_SECONDS" in
    *[!0-9]*) true ;;
    *) [ "${#OPEN_SOCKET_WAIT_SECONDS}" -gt "$OPEN_SOCKET_WAIT_MAX_DIGITS" ] ;;
  esac; then
    printf "aya: AYA_OPEN_WAIT_SECONDS must be whole seconds, at most %s digits, got '%s'\n" \
      "$OPEN_SOCKET_WAIT_MAX_DIGITS" "$OPEN_SOCKET_WAIT_SECONDS" >&2
    exit 1
  fi
}

# send_control then retries a missing or refusing socket for AYA_OPEN_WAIT_SECONDS.
wait_for_socket() {
  check_open_wait_seconds
  connect_wait="$OPEN_SOCKET_WAIT_SECONDS"
}

open_project() {
  target="${1:-.}"
  if [ -d "$target" ]; then
    abs=$(cd "$target" && pwd -P)
  else
    printf "aya: '%s' is not a directory\n" "$target" >&2
    exit 1
  fi

  socket=$(socket_path)
  # A named instance (AYA_SOCKET / AYA_HOME) may still be starting, or have left
  # a stale socket behind; launching the installed app instead would open the
  # project in the wrong Aya, so keep trying to reach it until the wait ends.
  if [ "$socket" != "$(normalize_path "$INSTALLED_APP_SOCKET")" ]; then
    wait_for_socket
    send_control open "$abs"
    return
  fi
  # A crashed Aya leaves its socket file behind; that is "not running", not an error.
  if [ -S "$socket" ]; then
    exit_if_not_listening=1
    status=0
    send_control open "$abs" || status=$?
    [ "$status" -eq "$NOT_LISTENING_EXIT" ] || exit "$status"
  fi

  case "$(uname -s)" in
    Darwin)
      if [ -d "/Applications/Aya.app" ]; then
        open -n -a "Aya" --args "$abs"
      else
        printf "aya: /Applications/Aya.app not found — run 'npm run package' and install the DMG\n" >&2
        exit 1
      fi
      ;;
    Linux)
      if command -v aya-app >/dev/null 2>&1; then
        aya-app "$abs" >/dev/null 2>&1 &
      else
        printf "aya: install the Aya AppImage / linux binary as 'aya-app' on PATH\n" >&2
        exit 1
      fi
      ;;
    *)
      printf "aya: unsupported platform '%s'\n" "$(uname -s)" >&2
      exit 1
      ;;
  esac
}

command="${1:-open}"
case "$command" in
  -h|--help|help)
    usage
    ;;
  open)
    [ "$#" -eq 0 ] || shift
    open_project "${1:-.}"
    ;;
  project)
    [ "$#" -eq 0 ] || shift
    if [ "${1:-}" != "open" ]; then usage_fail; fi
    [ "$#" -eq 0 ] || shift
    open_project "${1:-.}"
    ;;
  focus)
    send_control focus
    ;;
  debug)
    [ "$#" -eq 2 ] || usage_fail
    debug_switch "$2"
    ;;
  capabilities)
    send_control capabilities
    ;;
  machines)
    shift
    send_control machines "$@"
    ;;
  presets)
    [ "$#" -eq 0 ] || shift
    case "${1:-}" in
      "") send_control presets "" ;;
      --json) [ "$#" -eq 1 ] || usage_fail; send_control presets json ;;
      *) usage_fail ;;
    esac
    ;;
  notify)
    [ "$#" -eq 0 ] || shift
    title=""
    if [ "${1:-}" = "--title" ]; then
      [ "$#" -eq 0 ] || shift
      title="${1:-}"
      [ "$#" -eq 0 ] || shift
    fi
    body="$*"
    if [ -z "$body" ]; then usage_fail; fi
    send_control notify "$title" "$body"
    ;;
  remote)
    [ "$#" -eq 0 ] || shift
    if [ "${1:-}" != "--stdio" ]; then usage_fail; fi
    remote_stdio
    ;;
  pane)
    [ "$#" -eq 0 ] || shift
    # --project <slug> counts anywhere before `--`: it scopes the target, so it is never
    # part of a pane name or of the text sent. The rest is rotated back into "$@".
    project=""
    left=$#
    literal=""
    while [ "$left" -gt 0 ]; do
      arg=$1
      shift
      left=$((left - 1))
      if [ -z "$literal" ]; then
        case "$arg" in
          --) literal=1 ;;
          --project)
            if [ "$left" -eq 0 ] || [ -z "$1" ]; then usage_fail; fi
            project=$1
            shift
            left=$((left - 1))
            continue
            ;;
          --project=*)
            project=${arg#--project=}
            if [ -z "$project" ]; then usage_fail; fi
            continue
            ;;
        esac
      fi
      set -- "$@" "$arg"
    done
    action="${1:-}"
    [ "$#" -eq 0 ] || shift
    case "$action" in
      list|ls)
        send_control pane-list "$project"
        ;;
      read)
        target="${1:-}"
        if [ -z "$target" ] || [ "$#" -gt 1 ]; then usage_fail; fi
        send_control pane-read "$target" "$project"
        ;;
      send)
        target="${1:-}"
        [ "$#" -eq 0 ] || shift
        # Submit by default: an unsent handoff gets glued onto the next input (#116).
        # Flags count in any position; `--` ends flag parsing.
        submit="submit"
        text=""
        literal=""
        for arg do
          if [ -z "$literal" ]; then
            case "$arg" in
              --submit) continue ;;
              --no-submit) submit=""; continue ;;
              --) literal=1; continue ;;
            esac
          fi
          text="${text:+$text }$arg"
        done
        if [ -z "$target" ] || [ -z "$text" ]; then usage_fail; fi
        send_control pane-send "$target" "$text" "$submit" "$project"
        ;;
      *)
        usage_fail
        ;;
    esac
    ;;
  team)
    [ "$#" -eq 0 ] || shift
    action="${1:-}"
    [ "$#" -eq 0 ] || shift
    # A pane that outlived the app calls while Aya restarts: wait for its socket, do not give up.
    # stats and debug read the team's files and need no socket.
    case "$action" in
      stats|debug) ;;
      *) [ -z "${AYA_TERMINAL_ID:-}" ] || wait_for_socket ;;
    esac
    case "$action" in
      whoami) send_control team-whoami ;;
      inbox) send_control team-inbox ;;
      pause) send_control team-pause "$*" ;;
      new) send_control team-guide "$*" ;;
      debug)
        team="${1:-}"
        follow=""
        [ "$#" -eq 0 ] || shift
        for arg do
          case "$arg" in
            -f|--follow) follow=follow ;;
            *) usage_fail ;;
          esac
        done
        team_debug "$team" "$follow"
        ;;
      stats)
        team="${1:-}"
        flag=""
        [ "$#" -eq 0 ] || shift
        for arg do
          case "$arg" in
            --json|--now) flag="$arg" ;;
            *) usage_fail ;;
          esac
        done
        team_stats "$team" "$flag"
        ;;
      save)
        replace=""
        file=""
        for arg do
          case "$arg" in
            --replace) replace="replace" ;;
            *)
              if [ -n "$file" ]; then usage_fail; fi
              file="$arg"
              ;;
          esac
        done
        if [ -z "$file" ]; then usage_fail; fi
        if [ "$file" = "-" ]; then
          # A terminal on stdin would wait for typing no agent sends.
          if [ -t 0 ]; then
            printf "aya: team save - reads the team file from stdin; pipe it in or give a file; nothing was saved\n" >&2
            exit 1
          fi
          text=$(cat)
        elif [ -f "$file" ]; then
          text=$(cat -- "$file")
        else
          printf "aya: no such file: %s\n" "$file" >&2
          exit 1
        fi
        # A case pattern, not tr: BSD tr (macOS) rejects bytes invalid in a UTF-8 locale.
        case "$text" in
          *[![:space:]]*) ;;
          *)
            printf "aya: %s is empty; nothing was saved\n" "$file" >&2
            exit 1
            ;;
        esac
        send_control team-save "$text" "$replace"
        ;;
      start)
        team=""
        task=""
        to=""
        while [ "$#" -gt 0 ]; do
          case "$1" in
            --to)
              if [ "$#" -lt 2 ]; then usage_fail; fi
              to="$2"
              shift 2
              ;;
            *)
              if [ -z "$team" ]; then
                team="$1"
              elif [ -z "$task" ]; then
                task="$1"
              else
                usage_fail
              fi
              shift
              ;;
          esac
        done
        if [ -z "$team" ] || { [ -n "$to" ] && [ -z "$task" ]; }; then usage_fail; fi
        send_control team-start "$team" "$task" "$to"
        ;;
      open)
        replace=""
        team=""
        # Rebuilds "$@" as the role=target pairs alone, checked before the app sees them.
        for arg do
          shift
          case "$arg" in
            --replace) replace="replace" ;;
            *)
              if [ -z "$team" ]; then
                team="$arg"
                continue
              fi
              role="${arg%%=*}"
              if [ "$role" = "$arg" ] || [ -z "$role" ] || [ -z "${arg#*=}" ]; then
                printf "aya: expected role=target, got '%s'; nothing was opened\n" "$arg" >&2
                exit 1
              fi
              set -- "$@" "$arg"
              ;;
          esac
        done
        if [ -z "$team" ] || [ "$#" -eq 0 ]; then usage_fail; fi
        send_control team-open "$team" "$replace" "$@"
        ;;
      send)
        role="${1:-}"
        [ "$#" -eq 0 ] || shift
        text="$*"
        if [ -z "$role" ] || [ -z "$text" ]; then usage_fail; fi
        send_control team-send "$role" "$text"
        ;;
      *)
        usage_fail
        ;;
    esac
    ;;
  status)
    [ "$#" -eq 0 ] || shift
    level="${1:-}"
    [ "$#" -eq 0 ] || shift
    case "$level" in
      set|active) level="active" ;;
      waiting|done|error|clear) ;;
      *)
        usage_fail
        ;;
    esac
    text="$*"
    if [ "$level" != "clear" ] && [ -z "$text" ]; then usage_fail; fi
    send_control status "$level" "$text"
    ;;
  *)
    open_project "$command"
    ;;
esac
