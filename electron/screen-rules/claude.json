{
  "schemaVersion": 1,
  "ruleSetVersion": "1",
  "agent": "claude",
  "rules": [
    {
      "id": "claude-trust-confirmation",
      "kind": "dialog",
      "region": "tail",
      "pattern": "Enter\\s+to\\s+confirm\\s*[·•]\\s*Esc\\s+to\\s+(?:cancel|exit)",
      "flags": "i"
    },
    {
      "id": "transcript-view",
      "kind": "suppressor",
      "region": "screen",
      "pattern": "(?:showing|viewing)\\s+(?:full\\s+)?transcript|ctrl\\+r to (?:expand|toggle)",
      "flags": "i"
    },
    {
      "id": "composer-drawn",
      "kind": "suppressor",
      "region": "tail",
      "pattern": "(?:^|\\n)\\s*─{8,}\\n(?:\\s*❯(?!\\s*\\d+[.)])[^\\n]*\\n)?\\s*─{8,}(?:\\n(?![^\\n]*(?:\\?|\\[y\\/n\\]|\\(y\\/N\\))\\s*$)[^\\n]*){0,3}$",
      "flags": ""
    },
    {
      "id": "composer-hint",
      "kind": "suppressor",
      "region": "lastLine",
      "pattern": "\\?\\s*for shortcuts",
      "flags": "i"
    },
    {
      "id": "claude-busy",
      "kind": "busy",
      "region": "lastLine",
      "pattern": "\\besc to interrupt\\b",
      "flags": "i"
    },
    {
      "id": "claude-spinner",
      "kind": "busy",
      "region": "tail",
      "pattern": "^\\s*[✢✳✶✻✽]\\s+[^\\n…]{2,60}…(?:\\s*\\(.*\\))?\\s*$",
      "flags": "m"
    },
    {
      "id": "claude-account-setting",
      "kind": "account-setting",
      "region": "tail",
      "pattern": "\\bkeep\\s+allowing\\s+any\\s+reads\\s+outside\\s+the\\s+working\\s+directories\\b|\\bblock\\s+reads\\s+outside\\s+the\\s+working\\s+directories\\s+from\\s+now\\s+on\\b",
      "flags": ""
    }
  ]
}
